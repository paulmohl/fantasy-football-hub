{
  "manifest_version": 3,
  "name": "Fantasy Hub ESPN Connect",
  "version": "1.1.0",
  "description": "Lets Fantasy Hub read your ESPN fantasy leagues after you approve.",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.espn.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "https://predictfantasyfootball.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5173/*", "https://predictfantasyfootball.com/*"]
  }
}
